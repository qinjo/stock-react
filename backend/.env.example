# ── DeepSeek 分析配置（服务端专用；复制为 .env 并填入真实值，切勿提交）──
# 获取：https://platform.deepseek.com/api_keys
DEEPSEEK_API_KEY=
# 可选：默认 deepseek-chat
DEEPSEEK_MODEL=deepseek-chat

# ── 服务监听 ──
PORT=3001
HOST=127.0.0.1

# ── 分析缓存（毫秒，默认 10 分钟）──
ANALYSIS_CACHE_TTL_MS=600000

# ── 短线筛选器（本地日K库）──
# 库路径；缺省为 backend/data/kline.sqlite（已 gitignore 的构建产物）
MARKET_DB_PATH=
# 筛选结果缓存 TTL（毫秒，默认 6 小时）；键含数据指纹，数据一变即失效
SCREEN_CACHE_TTL_MS=21600000

# ── 限流（公开部署时启用；本地开发保持 false）──
RATE_LIMIT_ENABLED=false
RATE_LIMIT_MAX=30
RATE_LIMIT_WINDOW_MS=60000
